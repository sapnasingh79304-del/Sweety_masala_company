// Hero Banner Auto Change
const banners = [
    "100% Pure Indian Spices",
    "Freshly Packed Masala",
    "Best Quality at Best Price",
    "Order Online from Sweety Masala Company"
];

let index = 0;

function changeBanner() {
    const title = document.getElementById("hero-title");

    if (title) {
        title.innerText = banners[index];
    }

    index++;

    if (index >= banners.length) {
        index = 0;
    }
}

